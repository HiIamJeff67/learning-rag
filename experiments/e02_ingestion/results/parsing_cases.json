    "case": "html_rowspan",
    "before_method": "flatten each HTML row",
    "before": "150",
    "after": "Region: Taipei\nFee: 150"
  },
  {
    "case": "rst_cross_section",
    "before_method": "fixed size cutting",
    "before": [
      "Regular items\n=============\n\nRefund within 14 days.\n\nSale items\n==========\n\nNo refunds.\n"
    ],
    "after": [
      {
        "section": "Regular items",
        "text": "Regular items\n=============\n\nRefund within 14 days.\n\n"
      },
      {
        "section": "Sale items",
        "text": "Sale items\n==========\n\nNo refunds.\n"
      }
    ]
  }
