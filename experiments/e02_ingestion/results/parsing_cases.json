[
  {
    "case": "pdf_wrapped_title",
    "before_method": "raw PDF text lines",
    "before": [
      "Return",
      "policy"
    ],
    "after": "Return policy"
  },
  {
    "case": "pdf_visual_wrap",
    "before_method": "raw PDF text lines",
    "before": [
      "Refunds apply to items returned",
      "within 14 days."
    ],
    "after": "Refunds apply to items returned within 14 days."
  },
  {
    "case": "pdf_table_rows",
    "before_method": "PDF text without repeated field names",
    "before": [
      "Category Window",
      "Regular 14 days",
      "Sale No returns"
    ],
    "after": [
      "Category: Regular\nWindow: 14 days",
      "Category: Sale\nWindow: No returns"
    ]
  },
  {
    "case": "pdf_code_indentation",
    "before_method": "raw PDF text lines",
    "before": [
      "if can_refund:",
      "approve()"
    ],
    "after": "if can_refund:\n    approve()"
  },
  {
    "case": "markdown_code_block",
    "before_method": "global whitespace collapse",
    "before": "## Approval ```python if can_refund: approve() notify() ```",
    "after": "if can_refund:\n    approve()\n\nnotify()"
  },
  {
    "case": "markdown_escaped_pipe",
    "before_method": "split on every pipe",
    "before": [
      " Union ",
      " a \\",
      " b "
    ],
    "after": "Name: Union\nExample: a | b"
  },
